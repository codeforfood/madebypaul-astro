---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import Feature from '@components/Feature.astro'
import Counter from '@components/Counter.astro'
import ContentMedia from '@components/ContentMedia.astro'
import ExternalLink from '@components/ExternalLink.astro'
import { Accordion, AccordionItem, Avatar, AvatarGroup } from 'accessible-astro-components'
---

<DefaultLayout title="Home">
  <Hero />

  <a name="about"></a>
  <section class="mt-64 mb-32">
    <div class="container">
      <h2 class="mb-16 text-6xl text-center">About Paul</h2>
      <div class="grid grid-cols-1 gap-12 sm:grid-cols-1 md:grid-cols-3">
        <Counter count="20" title="Years" sub="in Tech Industry" />
        <Counter count="16" title="Years" sub="as a UX Designer" />
        <Counter count="7+" title="Years" sub="as a Design Team Lead" />
      </div>
      <div class="md:flex mt-16">
        <div class="flex-none md:w-120 mx-auto">
          <image src="its-me-award.png" alt="Paul holding an award for digital accessibility work">
        </div>
        <div class="flex-1 p-8 pr-16 text-lg">
            <p class="pb-4">At the <a href="https://jpl.nasa.gov" rel="nofollow">NASA Jet Propulsion Laboratory</a>, I design and build digital products in the Enterprise Business Information Services division. I also lead the Lab's efforts on digital accessibility.</p>
            <p class="pb-4">I work closely with our business partners and cross-functional engineering teams on projects that span institutional finance, flight project scheduling, business reporting, payroll and timekeeping, contract management, and supply chain information management systems.</p>
            <p class="pb-4">Empathy, creativity, and curiosity are my guiding pillars. My projects span across design disciplines as I lead teams that design and build enterprise web applications, improve digital services, conduct user research, and provide usability and accessibility testing. I use my abilities in product strategy, interaction design and web development to collaborate and lead teams.</p>
            <p class="pb-4">I'm a father, designer, researcher, educator, and learner.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="my-64">
    <div class="container">
      <h2 class="mb-16 text-6xl">Highlights of My Journey</h2>
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
        <Feature icon="lucide:sparkles" title="Leading the Digitial Accessibility Program at JPL">
        Fortunate to have been a part of a small team that included "accessible workplace" as one of our Lab's strategic imperatives and have spent the last few years leading the digital accessibility working group.
        </Feature>
        <Feature icon="lucide:blocks" title="Building a Design System">
          Leading the team that built a design system for Enterprise Business Information Services and improving our design team's time to hand-off by 70%.
        </Feature>
        <Feature icon="lucide:pen" title="Self-publishing a Poetry Book">
          I published a poetry book titled "Songs to Myself" that used generative AI to pair each poem with a set of images. Only the words in the poem were used as the prompt.
        </Feature>
      </div>
    </div>
  </section>
  <ContentMedia imgSrc="/accessible-components.webp">
    <h2>Accessible components</h2>
    <p class="text-2xl">
      This theme provides plenty of tried and tested Accessible Astro Components. Some are native to this theme and a
      lot of others are integrated using a <ExternalLink href="https://github.com/incluud/accessible-astro-components"
        >separate package</ExternalLink
      >. They'll get you up and running in building an accessible solution for your visitors.
    </p>
  </ContentMedia>
  <ContentMedia imgSrc="/wcag-compliant.webp" reverseImg={true}>
    <h2>WCAG 2.2 AA compliant</h2>
    <p class="text-2xl">
      Using semantic HTML, landmarks, skip links, screen reader friendly content, aria-labels, keyboard accessible
      navigation and components, clear outlines and tab indicators and the right color contrast, you're more certain of
      reaching WCAG AA compliance.
    </p>
  </ContentMedia>

</DefaultLayout>

<style>
  .avatar {
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-s);
  }
</style>
